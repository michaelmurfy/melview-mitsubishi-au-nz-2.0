    "supports-hap"
  ],
  "dependencies": {
    "tough-cookie": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "^9.39.1",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
