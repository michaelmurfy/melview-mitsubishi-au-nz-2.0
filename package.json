{
  "displayName": "AU/NZ Mitsubishi Air-Conditioners Bridge 2.0",
  "name": "homebridge-airconditioner-mitsubishi-au-nz-v2",
  "version": "1.4.7",
  "description": "Control your Mitsubishi Aircon units with Homebridge and Apple HomeKit",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/michaelmurfy/melview-mitsubishi-au-nz-2.0.git"
  },
  "bugs": {
    "url": "https://github.com/michaelmurfy/melview-mitsubishi-au-nz-2.0/issues"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
