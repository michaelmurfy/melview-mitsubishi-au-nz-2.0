{
  "pluginAlias": "MitsubishiAUNZ",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Mitsubishi Wi-Fi Control credentials. Units are discovered via Melview.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "MitsubishiAUNZ"
      },
      "user": {
        "title": "Email",
        "type": "string",
        "required": true,
        "format": "email"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true
      },
      "capabilityMode": {
        "title": "Setup mode",
        "type": "string",
        "default": "auto",
        "oneOf": [
          { "title": "Auto (AC tile + Fan tile with Auto / 5 speeds)", "enum": ["auto"] },
          { "title": "Manual", "enum": ["manual"] }
        ]
      },
      "preferLocalControl": {
        "title": "LAN /smart hop after Melview commands",
        "type": "boolean",
        "default": true
      },
      "pollIntervalSeconds": {
        "title": "Poll interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 5,
        "maximum": 300
      },
      "fanSpeed": {
        "title": "Fan speed tile (Auto + 5 stages)",
        "type": "boolean",
        "default": true
      },
      "swingMode": {
        "title": "Vertical swing on AC tile",
        "type": "boolean",
        "default": false
      },
      "dry": {
        "title": "Dry mode tile",
        "type": "boolean",
        "default": false
      },
      "fanMode": {
        "title": "Fan-only mode",
        "type": "boolean",
        "default": false
      },
      "airflowH": {
        "title": "Horizontal swing switch",
        "type": "boolean",
        "default": false
      },
      "outdoorTemp": {
        "title": "Outdoor temperature sensor",
        "type": "boolean",
        "default": false
      },
      "fanSpeedOnMainTile": {
        "title": "Fan speed on AC tile (advanced)",
        "type": "boolean",
        "default": false
      },
      "perUnitOverrides": {
        "title": "Per-unit overrides",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "unitId": {
              "title": "Unit ID",
              "type": "string",
              "required": true
            },
            "capabilityMode": {
              "title": "Setup mode",
              "type": "string",
              "oneOf": [
                { "title": "Auto", "enum": ["auto"] },
                { "title": "Manual", "enum": ["manual"] }
              ]
            },
            "preferLocalControl": {
              "title": "LAN /smart hop",
              "type": "boolean"
            },
            "fanSpeed": {
              "title": "Fan speed tile (Auto + 5 stages)",
              "type": "boolean"
            },
            "swingMode": {
              "title": "Vertical swing on AC tile",
              "type": "boolean"
            },
            "dry": {
              "title": "Dry mode tile",
              "type": "boolean"
            },
            "fanMode": {
              "title": "Fan-only mode",
              "type": "boolean"
            },
            "airflowH": {
              "title": "Horizontal swing switch",
              "type": "boolean"
            },
            "outdoorTemp": {
              "title": "Outdoor temperature sensor",
              "type": "boolean"
            },
            "fanSpeedOnMainTile": {
              "title": "Fan speed on AC tile",
              "type": "boolean"
            },
            "pollIntervalSeconds": {
              "title": "Poll interval (seconds)",
              "type": "integer",
              "minimum": 5,
              "maximum": 300
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Account",
      "items": ["name", "user", "password"]
    },
    {
      "type": "fieldset",
      "title": "Control",
      "items": ["capabilityMode", "preferLocalControl", "pollIntervalSeconds", "fanSpeed", "swingMode"]
    },
    {
      "type": "fieldset",
      "title": "Optional tiles",
      "items": ["dry", "outdoorTemp", "airflowH", "fanMode", "fanSpeedOnMainTile"]
    },
    {
      "key": "perUnitOverrides",
      "type": "array",
      "title": "Per-unit overrides",
      "buttonText": "Add override",
      "items": [
        "unitId",
        "capabilityMode",
        "preferLocalControl",
        "fanSpeed",
        "swingMode",
        "dry",
        "outdoorTemp",
        "airflowH",
        "fanMode",
        "pollIntervalSeconds"
      ]
    }
  ]
}
