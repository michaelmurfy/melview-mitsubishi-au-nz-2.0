{
  "pluginAlias": "MitsubishiAUNZ",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Mitsubishi Wi-Fi Control credentials.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "MitsubishiAUNZ"
      },
      "user": {
        "title": "Email",
        "type": "string",
        "required": true,
        "format": "email"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true
      },
      "fanSpeed": {
        "title": "Fan speed (Auto + 5 stages)",
        "type": "boolean",
        "default": true
      },
      "swingMode": {
        "title": "Vertical swing",
        "type": "boolean",
        "default": false
      },
      "dry": {
        "title": "Dry mode",
        "type": "boolean",
        "default": false
      },
      "outdoorTemp": {
        "title": "Outdoor temperature",
        "type": "boolean",
        "default": false
      },
      "airflowH": {
        "title": "Horizontal swing",
        "type": "boolean",
        "default": false
      },
      "fanMode": {
        "title": "Fan-only mode",
        "type": "boolean",
        "default": false
      },
      "pollIntervalSeconds": {
        "title": "Poll interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 5,
        "maximum": 300
      },
      "perUnitOverrides": {
        "title": "Units",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "room": {
              "title": "Unit",
              "type": "string",
              "readonly": true
            },
            "unitId": {
              "title": "Unit ID",
              "type": "string",
              "readonly": true,
              "required": true
            },
            "fanSpeed": {
              "title": "Fan speed (Auto + 5 stages)",
              "type": "boolean"
            },
            "swingMode": {
              "title": "Vertical swing",
              "type": "boolean"
            },
            "dry": {
              "title": "Dry mode",
              "type": "boolean"
            },
            "outdoorTemp": {
              "title": "Outdoor temperature",
              "type": "boolean"
            },
            "airflowH": {
              "title": "Horizontal swing",
              "type": "boolean"
            },
            "fanMode": {
              "title": "Fan-only mode",
              "type": "boolean"
            },
            "pollIntervalSeconds": {
              "title": "Poll interval (seconds)",
              "type": "integer",
              "minimum": 5,
              "maximum": 300
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Account",
      "items": ["name", "user", "password"]
    },
    {
      "type": "fieldset",
      "title": "HomeKit",
      "items": ["fanSpeed", "swingMode", "dry", "outdoorTemp", "airflowH", "fanMode", "pollIntervalSeconds"]
    },
    {
      "key": "perUnitOverrides",
      "type": "array",
      "title": "Units (auto-populated from Melview)",
      "expandable": true,
      "expanded": true,
      "orderable": false,
      "items": [
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": ["perUnitOverrides[].room", "perUnitOverrides[].unitId"]
        },
        "perUnitOverrides[].fanSpeed",
        "perUnitOverrides[].swingMode",
        "perUnitOverrides[].dry",
        "perUnitOverrides[].outdoorTemp",
        "perUnitOverrides[].airflowH",
        "perUnitOverrides[].fanMode",
        "perUnitOverrides[].pollIntervalSeconds"
      ]
    }
  ]
}
